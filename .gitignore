# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
relay/node_modules/

# relay build artifacts + secrets (relay runs on the on-prem Windows box, not Vercel)
relay/relay.config.json
relay/relay.exe
relay/logs/
# local test / QA scripts
test-manual-scan.mjs
cleanup_qa.mjs
scripts/.tag-backup.json
*.bak
