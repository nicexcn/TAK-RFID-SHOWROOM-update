generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  firstName   String
  lastName    String
  password    String
  role        String   @default("user")
  permissions Json     @default("{\"dashboard\":true,\"products\":false,\"rfid\":false}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  rfidTag       String         @unique
  brand         String?
  materialType  String?
  category      String?
  productCode   String?
  name          String
  size          String?
  colour        String?
  description   String?
  imageUrl      String?
  location      String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  scans         Scan[]
  images        ProductImage[]
  notifications Notification[]
}

model Customer {
  id               String         @id @default(cuid())
  customerCode     String         @unique
  fullName         String         @default("")
  title            String         @default("")
  titleOther       String?
  company          String         @default("")
  phone            String         @default("")
  email            String         @default("")
  lineId           String?
  knowChannel      String[]       @default([])
  knowChannelOther String?
  pdpaConsent      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  notifications    Notification[]
}

model Session {
  id           String    @id @default(cuid())
  customerCode String
  customerId   String?
  deviceId     String?   // station id (one configured staff station/tablet) — concurrent sessions are keyed per station
  // The physical reader (mac/serial) bound to this session. Set when staff serve a
  // customer with a relay-connected reader. Server-side ingest (/api/scan) maps an
  // incoming scan's device_id → the active Session with this readerId for attribution.
  readerId     String?
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime  @default(now()) // heartbeat; idle past TTL => treated as inactive (abandonment)
  displayedAt  DateTime? // set when this session is explicitly pushed to the TV ("Send to Display")
  createdAt    DateTime  @default(now())
  scans        Scan[]

  @@index([deviceId, isActive])
  @@index([readerId, isActive])
}

model Scan {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  // A scan always belongs to a session; the customer is derived via session.customerId
  // (single source of truth). sessionId is required so the dedup constraint below
  // is a real guarantee (NULL sessionIds would otherwise bypass uniqueness).
  session    Session  @relation(fields: [sessionId], references: [id])
  sessionId  String
  scannedAt  DateTime @default(now())
  // Prepare workflow (customer req #2): NONE → PREPARING → COMPLETE. Persisted so
  // status survives reload and is visible across staff stations (was client-only).
  prepareStatus String @default("NONE")
  // Takeaway quantity the customer wants to take home (customer req #2). This is also the
  // BORROW quantity — takeaway == loan. The fields below track the return side.
  takeawayQty   Int    @default(0)
  // Borrow/return tracking. returnedQty of takeawayQty have come back; returnedAt is set
  // when fully returned. dueDate is an OPTIONAL override — the effective due date is
  // (dueDate ?? scannedAt + BORROW_DAYS), so existing takeaways get a due date for free
  // and the scan flow stays untouched. See src/lib/loanStatus.ts.
  returnedQty   Int    @default(0)
  returnedAt    DateTime?
  dueDate       DateTime?
  // Reader that produced this scan — mac (handheld) / serial (Speedway). MPT confirms
  // it's in every message + unique (customer req #3: "ตำแหน่งที่ Scan" / device→customer).
  deviceId      String?
  updatedAt     DateTime @updatedAt @default(now())

  @@unique([sessionId, productId])
  @@index([sessionId])
  @@index([productId])
}

model Notification {
  id         String    @id @default(cuid())
  type       String    @default("PREPARE_PRODUCT")
  title      String
  message    String    @default("")
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?
  sessionId  String?
  status     String    @default("PENDING")
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model DropdownOption {
  id        String   @id @default(cuid())
  type      String
  value     String
  createdAt DateTime @default(now())
  @@unique([type, value])
}

model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AppSettings {
  id              String   @id @default("singleton")
  defaultFilter   String   @default("daily")
  yearA           Int      @default(2025)
  yearB           Int      @default(2026)
  graphColor      Int      @default(0)
  takeawayLimit   Int      @default(3)
  takeawayEnabled Boolean  @default(true)
  // Default loan period (days) for borrow/return — the effective due date is
  // (Scan.dueDate ?? scannedAt + borrowDays). Per-loan dueDate overrides it. See loanStatus.ts.
  borrowDays      Int      @default(14)
  visibleWidgets  Json     @default("{\"walkins\":true,\"customerTypes\":true,\"newVsTotal\":true,\"comparisonGraph\":true,\"categoryGraph\":true}")
  // TV display config (was UI-only state with a fake "Save" — now persisted).
  slideDuration   Int      @default(5)   // seconds each product image shows
  // Optional video that loops full-screen on /display when idle (no product showing).
  // Empty = the logo idle screen. Uploaded to storage; this holds its public URL.
  idleVideoUrl    String   @default("")
  // /display screen rotation in degrees (0/90/180/270) for portrait-mounted TVs etc.
  // Global default; a per-screen ?rotate= URL param overrides it.
  displayRotation Int      @default(0)
  sessionTimeout  Int      @default(30)  // minutes idle before a session is abandoned
  scheduleEnabled Boolean  @default(false)
  scheduleOn      String   @default("08:00")
  scheduleOff     String   @default("18:00")
  scheduleDays    String[] @default(["Mon", "Tue", "Wed", "Thu", "Fri"])
  // Option E cloud relay base, e.g. "wss://relay.fly.dev". Set once; readers then
  // just need a room id (deviceId). Empty = use direct LAN ws:// URLs.
  relayUrl        String   @default("")
  // Central reader registry (one source of truth for the whole app). Each entry is
  // { id, name, device, url }: `device` is the relay tag (?device=<device> against
  // relayUrl); `url` is an optional explicit override (LAN IP / full ws). The scan +
  // display pages render these as a named dropdown. See src/lib/readers.ts.
  readers         Json     @default("[]")
  updatedAt       DateTime @updatedAt
}
